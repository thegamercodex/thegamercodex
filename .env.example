# Optional: override the production URL used in metadata, sitemap.xml,
# robots.txt, OG tags, JSON-LD canonical links, and hreflang alternates.
# Defaults to https://thegamercodex.com when unset.
# Use this on Vercel previews, the temporary *.vercel.app subdomain, or
# any non-production environment so search engines see the right URLs.
NEXT_PUBLIC_SITE_URL=

# Telegram bot used by /api/report-broken-link to forward broken-link
# reports to a private channel. Both vars must be set for the route to
# accept reports (otherwise it returns 503).
#   - TELEGRAM_BOT_TOKEN: from @BotFather. SERVER ONLY (no NEXT_PUBLIC_).
#   - TELEGRAM_CHANNEL_ID: numeric chat_id of the private channel (the
#     bot must be admin). Format: -100xxxxxxxxxx
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
